/**
 * Generates supabase/seed.sql from the TypeScript content files so the static
 * fallback and the database never drift. Run: `npm run db:seed:gen`.
 */
import { writeFileSync } from "node:fs";
import { COURSE_ONE, FORUM_GENERAL_CATEGORY } from "../lib/content/course.ts";
import { GLOSSARY } from "../lib/content/glossary.ts";

function q(value: string | undefined | null): string {
  if (value === undefined || value === null) return "null";
  return `'${value.replaceAll("'", "''")}'`;
}

const lines: string[] = [
  "-- GENERATED by scripts/gen-seed.ts. Do not edit by hand.",
  "begin;",
  "",
  `insert into public.courses (slug, title, subtitle, description, status)`,
  `values (${q(COURSE_ONE.slug)}, ${q(COURSE_ONE.title)}, ${q(COURSE_ONE.subtitle)}, ${q(COURSE_ONE.description)}, 'live')`,
  `on conflict (slug) do update set title = excluded.title, subtitle = excluded.subtitle, description = excluded.description;`,
  "",
];

for (const m of COURSE_ONE.modules) {
  lines.push(
    `insert into public.modules (course_id, "order", slug, title, summary)`,
    `select id, ${m.order}, ${q(m.slug)}, ${q(m.title)}, ${q(m.summary)} from public.courses where slug = ${q(COURSE_ONE.slug)}`,
    `on conflict (course_id, slug) do update set title = excluded.title, summary = excluded.summary, "order" = excluded."order";`,
  );
}

lines.push(
  "",
  `insert into public.batches (course_id, name, starts_on, ends_on, capacity, applications_open, require_payment_for_notes)`,
  `select id, ${q(COURSE_ONE.batch.name)}, date '2026-11-16', date '2026-12-06', ${COURSE_ONE.batch.capacity}, true, true`,
  `from public.courses c where slug = ${q(COURSE_ONE.slug)}`,
  `and not exists (select 1 from public.batches b where b.course_id = c.id and b.name = ${q(COURSE_ONE.batch.name)});`,
  "",
);

for (const m of COURSE_ONE.modules) {
  lines.push(
    `insert into public.forum_categories (course_id, module_id, slug, name, "order")`,
    `select c.id, m.id, ${q(m.slug)}, ${q(m.title)}, ${m.order} from public.courses c join public.modules m on m.course_id = c.id and m.slug = ${q(m.slug)}`,
    `where c.slug = ${q(COURSE_ONE.slug)} on conflict (course_id, slug) do nothing;`,
  );
}
lines.push(
  `insert into public.forum_categories (course_id, slug, name, "order")`,
  `select id, ${q(FORUM_GENERAL_CATEGORY.slug)}, ${q(FORUM_GENERAL_CATEGORY.name)}, 99 from public.courses where slug = ${q(COURSE_ONE.slug)}`,
  `on conflict (course_id, slug) do nothing;`,
  "",
);

for (const t of GLOSSARY) {
  lines.push(
    `insert into public.glossary_terms (slug, term, short_def, body_md, example_md, source_ref, module_id)`,
    `select ${q(t.slug)}, ${q(t.term)}, ${q(t.shortDef)}, ${q(t.body)}, ${q(t.example)}, ${q(t.sourceRef)},`,
    `  (select m.id from public.modules m join public.courses c on c.id = m.course_id where c.slug = ${q(COURSE_ONE.slug)} and m.slug = ${q(t.module)})`,
    `on conflict (slug) do update set term = excluded.term, short_def = excluded.short_def, body_md = excluded.body_md, example_md = excluded.example_md, source_ref = excluded.source_ref, module_id = excluded.module_id;`,
  );
}

lines.push("", "-- Related terms (second pass, once all ids exist).");
for (const t of GLOSSARY) {
  if (t.related.length === 0) continue;
  const slugs = t.related.map(q).join(", ");
  lines.push(
    `update public.glossary_terms set related = array(select id from public.glossary_terms where slug in (${slugs})) where slug = ${q(t.slug)};`,
  );
}

lines.push("", "commit;", "");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n"));
console.log(`seed.sql written: ${GLOSSARY.length} glossary terms, ${COURSE_ONE.modules.length} modules`);
